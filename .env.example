# REMINDER PWA - Environment Configuration Example
# Copy to environment.ts or set in your CI/CD / Vercel dashboard.
# NEVER commit production OAuth client secrets or private credentials.

# Google OAuth 2.0 Web Client ID (Public identifier)
# e.g., 123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Single-User Authorized Email Address (Single-user allowlist)
# Only this email will be allowed to synchronize or access cloud resources.
# Leave blank to prompt the user during initial setup.
AUTHORIZED_EMAIL=

# Google Drive Application Folder Name
DRIVE_APP_FOLDER_NAME=REMINDER_APP

# Scopes: Request MINIMUM required permission only
# drive.file grants access ONLY to files created or opened by this app.
DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email

